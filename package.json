{
  "name": "@jacobragsdale/ui",
  "version": "1.2.0",
  "description": "Shared theme, shadcn/ui components, and strict lint/type configs for Jacob's web apps.",
  "license": "MIT",
  "repository": "github:jacobragsdale/ui",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "files": [
    "src",
    "config",
    "DESIGN.md"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles.css": "./src/styles.css",
    "./eslint": "./config/eslint.js",
    "./vite": {
      "types": "./config/vite.d.ts",
      "default": "./config/vite.js"
    },
    "./prettier": "./config/prettier.js",
    "./tsconfig.json": "./config/tsconfig.json"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "prettier": "./config/prettier.js",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --dir template typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm --dir template lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "pnpm --dir template build",
    "shadcn": "shadcn",
    "test": "node --test"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint-react/eslint-plugin": "^5.21.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@shadcn/lint": "^0.2.0",
    "@typescript-eslint/parser": "^8.71.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "^76.0.0",
    "lucide-react": "^1.48.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.71.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
